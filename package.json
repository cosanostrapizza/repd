    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.1",
    "openai": "^7.58.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
